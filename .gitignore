# Built application files
*.apk
*.ap_
*.dex

# Java class files
*.class

# Generated files
gen/
out/
build/
obj/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation panel temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
*.jks
*.keystore

# OS-specific
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.swp
*~

# AOSP/TWRP source-built binaries - DO NOT include as prebuilts
# These are built from source by TWRP and including them causes "overriding commands" build errors
# Use BUILD_BROKEN_DUP_RULES := true in BoardConfig.mk to handle conflicts
recovery/root/system/bin/keystore
recovery/root/system/bin/keystore_auth
recovery/root/system/bin/logd
recovery/root/system/bin/servicemanager
recovery/root/system/bin/hwservicemanager

# Recovery fstab backup files
recovery.fstab.bak
