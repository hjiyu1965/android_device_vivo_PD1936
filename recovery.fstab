# TWRP fstab for vivo PD1936 (V1936A)
# Based on original recovery.fstab from stock firmware PD1936_A_9.15.14
# NOTE: This is a NON-A/B device (dedicated recovery partition)

# Device         Mount point       FS type    Source                                                     Flags

# System (AVB verified)
/system          ext4              /dev/block/bootdevice/by-name/system                       flags=display=;avb
/system_root     auto              /dev/block/bootdevice/by-name/system                       flags=display=

# Vendor
/vendor          ext4              /dev/block/bootdevice/by-name/vendor                       flags=display=vendor

# Metadata (needed for FBE key storage)
/metadata        ext4              /dev/block/bootdevice/by-name/metadata                     flags=display=metadata

# Data (FBE + ICE encryption, F2FS filesystem)
/data            f2fs              /dev/block/bootdevice/by-name/userdata                     flags=display=data;encryptable=/data;fileencryption=ice,wrappedkey;length=-16384

# Cache
/cache           ext4              /dev/block/bootdevice/by-name/cache                        flags=display=cache

# OEM
/oem             ext4              /dev/block/bootdevice/by-name/oem                           flags=display=oem

# External SD card
/storage/sdcard1 vfat              /devices/platform/soc/8804000.sdhci/mmc_host*              flags=display=sdcard1;storage;removable
/storage/sdcard1 vfat              /devices/platform/soc/1da4000.ufshc_card/host*             flags=display=sdcard1;storage;removable

# Modem firmware
/vendor/firmware_mnt  vfat         /dev/block/bootdevice/by-name/modem                        flags=display=firmware_mnt

# DSP
/vendor/dsp      ext4              /dev/block/bootdevice/by-name/dsp                           flags=display=dsp

# Persist
/mnt/vendor/persist  ext4          /dev/block/bootdevice/by-name/persist                      flags=display=persist

# Bluetooth firmware
/vendor/bt_firmware  vfat          /dev/block/bootdevice/by-name/bluetooth                    flags=display=bt_firmware

# Raw partitions
/misc            emmc              /dev/block/bootdevice/by-name/misc                         flags=display=misc
/boot            emmc              /dev/block/bootdevice/by-name/boot                         flags=display=boot
/recovery        emmc              /dev/block/bootdevice/by-name/recovery                     flags=display=recovery
/vbmeta          emmc              /dev/block/bootdevice/by-name/vbmeta                       flags=display=vbmeta
/dtbo            emmc              /dev/block/bootdevice/by-name/dtbo                         flags=display=dtbo

# USB OTG
/storage/usbotg  vfat              /devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*      flags=display=usbotg;storage;removable

# Additional mounts
/otg             vfat              /dev/block/sdg1                                            flags=display=otg
/sdcard          vfat              /dev/block/mmcblk1p1                                       flags=display=sdcard
