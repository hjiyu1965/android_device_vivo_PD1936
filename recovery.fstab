# TWRP fstab for vivo PD1936 (V1936A)
# Based on original recovery.fstab from stock firmware PD1936_A_9.15.14
# NOTE: This is a NON-A/B device (dedicated recovery partition)
#       No slotselect flags - this device has no A/B slots

# Device         Mount point       FS type    Source                                                     Flags

# System (system_root_image - TWRP handles /system_root automatically)
/system          ext4              /dev/block/bootdevice/by-name/system                       flags=display=System;wait;backup=1

# Vendor
/vendor          ext4              /dev/block/bootdevice/by-name/vendor                       flags=display=Vendor;wait;backup=1

# Metadata (needed for FBE key storage - MUST mount before /data)
/metadata        ext4              /dev/block/bootdevice/by-name/metadata                     flags=display=Metadata;wait;check

# Data (FBE + ICE encryption, F2FS filesystem)
# latemount: TWRP mounts this after crypto services are ready
# encryptable: tells TWRP this partition is encrypted
/data            f2fs              /dev/block/bootdevice/by-name/userdata                     flags=display=Data;latemount;wait;check;encryptable=/data;backup=1;wipeinguids

# Cache
/cache           ext4              /dev/block/bootdevice/by-name/cache                        flags=display=Cache;wait;backup=1

# OEM
/oem             ext4              /dev/block/bootdevice/by-name/oem                           flags=display=OEM;wait;backup=1

# External SD card
/external_sd     vfat              /devices/platform/soc/8804000.sdhci/mmc_host*              flags=display=External_SD;storage;removable;fsflags=utf8;backup=0
/external_sd     vfat              /devices/platform/soc/1da4000.ufshc_card/host*             flags=display=External_SD;storage;removable;fsflags=utf8;backup=0

# Modem firmware
/vendor/firmware_mnt  vfat         /dev/block/bootdevice/by-name/modem                        flags=display=Firmware;wait;backup=0

# DSP
/vendor/dsp      ext4              /dev/block/bootdevice/by-name/dsp                           flags=display=DSP;wait;backup=0

# Persist
/mnt/vendor/persist  ext4          /dev/block/bootdevice/by-name/persist                      flags=display=Persist;wait;check;backup=0

# Bluetooth firmware
/vendor/bt_firmware  vfat          /dev/block/bootdevice/by-name/bluetooth                    flags=display=BT_Firmware;wait;backup=0

# Raw partitions (no filesystem - emmc type for raw block access)
/misc            emmc              /dev/block/bootdevice/by-name/misc                         flags=display=Misc;backup=0
/boot            emmc              /dev/block/bootdevice/by-name/boot                         flags=display=Boot;backup=1
/recovery        emmc              /dev/block/bootdevice/by-name/recovery                     flags=display=Recovery;backup=0
/vbmeta          emmc              /dev/block/bootdevice/by-name/vbmeta                       flags=display=Vbmeta;backup=0
/dtbo            emmc              /dev/block/bootdevice/by-name/dtbo                         flags=display=DTBO;backup=0

# USB OTG
/usbotg          vfat              /devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*      flags=display=USB_OTG;storage;removable;fsflags=utf8;backup=0
