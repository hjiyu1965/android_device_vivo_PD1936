/ddr             emmc              /dev/block/bootdevice/by-name/ddr             flags=display=DDR;backup=1;flashimg
/cdt             emmc              /dev/block/bootdevice/by-name/cdt             flags=display=CDT;backup=1;flashimg
/dip             emmc              /dev/block/bootdevice/by-name/dip             flags=display=DIP;backup=1;flashimg
/devinfo         emmc              /dev/block/bootdevice/by-name/devinfo         flags=display=DevInfo;backup=1;flashimg
/limits          emmc              /dev/block/bootdevice/by-name/limits          flags=display=Limits;backup=1;flashimg
/logfs           emmc              /dev/block/bootdevice/by-name/logfs           flags=display=LogFS;backup=1;flashimg
/logdump         emmc              /dev/block/bootdevice/by-name/logdump         flags=display=LogDump;backup=1;flashimg
/modemst1        emmc              /dev/block/bootdevice/by-name/modemst1        flags=display=ModemST1;backup=1;flashimg
/modemst2        emmc              /dev/block/bootdevice/by-name/modemst2        flags=display=ModemST2;backup=1;flashimg
/fsc             emmc              /dev/block/bootdevice/by-name/fsc             flags=display=FSC;backup=1;flashimg
/fsg             emmc              /dev/block/bootdevice/by-name/fsg             flags=display=FSG;backup=1;flashimg
/secdata         emmc              /dev/block/bootdevice/by-name/secdata         flags=display=SecData;backup=1;flashimg
/seed            emmc              /dev/block/bootdevice/by-name/seed            flags=display=Seed;backup=1;flashimg
/splash          emmc              /dev/block/bootdevice/by-name/splash          flags=display=Splash;backup=1;flashimg
/spunvm          emmc              /dev/block/bootdevice/by-name/spunvm          flags=display=SPUNVM;backup=1;flashimg
