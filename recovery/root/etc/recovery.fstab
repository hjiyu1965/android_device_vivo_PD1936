/keystore        emmc              /dev/block/bootdevice/by-name/keystore        flags=display=Keystore;backup=1;flashimg
/rawdump         emmc              /dev/block/bootdevice/by-name/rawdump         flags=display=RawDump;backup=1;flashimg
/apanic          emmc              /dev/block/bootdevice/by-name/apanic          flags=display=APanic;backup=1;flashimg
