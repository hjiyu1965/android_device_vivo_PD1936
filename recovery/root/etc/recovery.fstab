# TWRP fstab for vivo PD1936 (V1936A)
# Based on stock recovery.fstab, adapted for TWRP
# NON-A/B device (dedicated recovery partition)

# System (system_root_image)
/system_root     auto              /dev/block/bootdevice/by-name/system                       flags=display=System;wait;backup=1

# Vendor
/vendor          ext4              /dev/block/bootdevice/by-name/vendor                       flags=display=Vendor;wait;backup=1

# Metadata (needed for FBE key storage - MUST mount before /data)
/metadata        ext4              /dev/block/bootdevice/by-name/metadata                     flags=display=Metadata;wait;check

# Data (FBE encryption, F2FS filesystem)
# TWRP fstab - latemount removed for compatibility
/data            f2fs              /dev/block/bootdevice/by-name/userdata                     flags=display=Data;wait;check;encryptable=/data;keydirectory=/data;fileencryption=ice:aes-256-cts:v1+wrappedkey_v0;fsflags=noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt

# Cache
/cache           ext4              /dev/block/bootdevice/by-name/cache                        flags=display=Cache;wait

# OEM
/oem             ext4              /dev/block/bootdevice/by-name/oem                           flags=display=OEM;wait;backup=1

# External SD card
/external_sd     vfat              /devices/platform/soc/8804000.sdhci/mmc_host*              flags=display=External_SD;storage;removable;fsflags=utf8
/external_sd     vfat              /devices/platform/soc/1da4000.ufshc_card/host*             flags=display=External_SD;storage;removable;fsflags=utf8

# Modem firmware
/vendor/firmware_mnt  vfat         /dev/block/bootdevice/by-name/modem                        flags=display=Firmware;wait;backup=1

# DSP
/vendor/dsp      ext4              /dev/block/bootdevice/by-name/dsp                           flags=display=DSP;wait;backup=1

# Persist
/persist          ext4              /dev/block/bootdevice/by-name/persist                      flags=display=Persist;wait;check;backup=1

# Bluetooth firmware
/vendor/bt_firmware  vfat          /dev/block/bootdevice/by-name/bluetooth                    flags=display=BT_Firmware;wait;backup=1

# Raw partitions
/misc            emmc              /dev/block/bootdevice/by-name/misc                         flags=display=Misc;IsPresent;backup=1;flashimg
/boot            emmc              /dev/block/bootdevice/by-name/boot                         flags=display=Boot;backup=1;flashimg
/recovery        emmc              /dev/block/bootdevice/by-name/recovery                     flags=display=Recovery;backup=1;flashimg
/vbmeta          emmc              /dev/block/bootdevice/by-name/vbmeta                       flags=display=Vbmeta;backup=1;flashimg
/dtbo            emmc              /dev/block/bootdevice/by-name/dtbo                         flags=display=DTBO;backup=1;flashimg

# USB OTG
/usbotg          vfat              /devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*      flags=display=USB_OTG;storage;removable;fsflags=utf8

# Bootloader / firmware partitions (raw images)
/abl             emmc              /dev/block/bootdevice/by-name/abl             flags=display=ABL;backup=1;flashimg
/aop             emmc              /dev/block/bootdevice/by-name/aop             flags=display=AOP;backup=1;flashimg
/cmnlib          emmc              /dev/block/bootdevice/by-name/cmnlib          flags=display=CMNLIB;backup=1;flashimg
/cmnlib64        emmc              /dev/block/bootdevice/by-name/cmnlib64        flags=display=CMNLIB64;backup=1;flashimg
/devcfg          emmc              /dev/block/bootdevice/by-name/devcfg          flags=display=DEVCFG;backup=1;flashimg
/hyp             emmc              /dev/block/bootdevice/by-name/hyp             flags=display=HYP;backup=1;flashimg
/tz              emmc              /dev/block/bootdevice/by-name/tz              flags=display=TZ;backup=1;flashimg
/xbl             emmc              /dev/block/bootdevice/by-name/xbl             flags=display=XBL;backup=1;flashimg
/xbl_config      emmc              /dev/block/bootdevice/by-name/xbl_config      flags=display=XBL_Config;backup=1;flashimg
/xbl_configbak   emmc              /dev/block/bootdevice/by-name/xbl_configbak   flags=display=XBL_Config_Bak;backup=1;flashimg
/xblbak          emmc              /dev/block/bootdevice/by-name/xblbak          flags=display=XBL_Bak;backup=1;flashimg
/keymaster       emmc              /dev/block/bootdevice/by-name/keymaster       flags=display=Keymaster;backup=1;flashimg
/qupfw           emmc              /dev/block/bootdevice/by-name/qupfw           flags=display=QUPFW;backup=1;flashimg
/storsec         emmc              /dev/block/bootdevice/by-name/storsec         flags=display=STOR_SEC;backup=1;flashimg
/uefisecapp      emmc              /dev/block/bootdevice/by-name/uefisecapp      flags=display=UEFI_SecApp;backup=1;flashimg
/uefivarstore    emmc              /dev/block/bootdevice/by-name/uefivarstore    flags=display=UEFI_VarStore;backup=1;flashimg
/imagefv         emmc              /dev/block/bootdevice/by-name/imagefv         flags=display=ImageFV;backup=1;flashimg
/toolsfv         emmc              /dev/block/bootdevice/by-name/toolsfv         flags=display=ToolsFV;backup=1;flashimg
/multiimgoem     emmc              /dev/block/bootdevice/by-name/multiimgoem     flags=display=MultiImg_OEM;backup=1;flashimg
/multiimgqti     emmc              /dev/block/bootdevice/by-name/multiimgqti     flags=display=MultiImg_QTI;backup=1;flashimg
