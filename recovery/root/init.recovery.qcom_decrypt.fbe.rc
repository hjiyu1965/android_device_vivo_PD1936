# TWRP Qualcomm FBE Decryption - FBE-specific services
# Gatekeeper and wait_for_keymaster for FBE decryption chain

# Start gatekeeper when keymaster is running
on property:init.svc.keymaster-4-0-qti=running
    start gatekeeper-1-0-qti

# gatekeeper HAL service - provides gatekeeper via HIDL
service gatekeeper-1-0-qti /vendor/bin/android.hardware.gatekeeper@1.0-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

# wait_for_keymaster - TWRP built binary, waits for keymaster to be ready
service wait_for_keymaster /system/bin/wait_for_keymaster
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
