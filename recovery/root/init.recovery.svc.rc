# init.recovery.svc.rc - vivo PD1936
# Minimal service configuration for TWRP
# NOTE: Do NOT define servicemanager, hwservicemanager, vndservicemanager,
# logd, or tombstoned here - TWRP provides these as built-in services.
# Defining them again causes init conflicts and prevents TWRP from booting.

on early-init
    mkdir /vendor/firmware_mnt
    symlink /vendor/firmware_mnt /firmware
    mkdir /mnt/vendor
    mkdir /mnt/vendor/persist
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    symlink /mnt/vendor/persist /persist

# vivo LED indicator service
service flash_light /system/bin/little_buddy --light_tips
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

on property:recovery.emergent_mode=1
    start flash_light

# vivo memory info service
service mem_info /system/bin/little_buddy --mem_info
    disabled
    user root
    group root
    onrestart setprop recovery.svc.start.mem_info 0
    seclabel u:r:recovery:s0

on property:recovery.svc.start.mem_info=1
    start mem_info
