# init.recovery.platform.rc - vivo PD1936
# Crypto service definitions for FBE decryption
# Only services with existing binaries are defined here.

# Trigger crypto services when TWRP requests them
on property:recovery.service=1
    start qseecomd
    start keymaster-4-0
    start gatekeeper-1-0
    start wait_for_keymaster
    start guardianangle

# qseecomd - Qualcomm Secure Execution Environment daemon
service qseecomd /vendor/bin/qseecomd
    disabled
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0

# Keymaster 4.0 HAL service
service keymaster-4-0 /vendor/bin/android.hardware.keymaster@4.0-service-qti
    disabled
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0

# Gatekeeper 1.0 HAL service
service gatekeeper-1-0 /vendor/bin/android.hardware.gatekeeper@1.0-service-qti
    disabled
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0

# wait_for_keymaster - waits for keymaster service to be ready
service wait_for_keymaster /system/bin/wait_for_keymaster
    disabled
    user root
    seclabel u:r:recovery:s0

# guardianangle - vivo security service
service guardianangle /system/bin/guardianangle
    disabled
    user root
    seclabel u:r:recovery:s0

# vts_app_recovery - vivo touchscreen firmware update
service vts_app_recovery /system/bin/vts_app_recovery --update
    disabled
    user system
    group system
    seclabel u:r:recovery:s0
    oneshot
