# FBE decryption services for vivo PD1936
# Based on TeamWin/android_device_qcom_twrp-common standard flow
#
# Decryption chain:
# 1. ro.crypto.state=encrypted -> set crypto.ready=1
# 2. crypto.ready=1 + hwservicemanager.ready=true -> start qseecomd
# 3. sys.listeners.registered=true -> start keymaster-4-0
# 4. vendor.sys.listeners.registered=true -> start gatekeeper-1-0
# 5. twrp.all.users.decrypted=true -> stop all crypto services

on fs
    # qseecomd needs these device permissions
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion

on property:ro.crypto.state=encrypted
    # Trigger decryption chain - TWRP sets this when it detects encryption
    setprop crypto.ready 1

on property:crypto.ready=1 && property:hwservicemanager.ready=true
    start qseecomd

on property:sys.listeners.registered=true
    start keymaster-4-0

on property:vendor.sys.listeners.registered=true
    start gatekeeper-1-0
    start guardianangle

on property:twrp.all.users.decrypted=true
    setprop crypto.ready 0
    stop qseecomd
    stop gatekeeper-1-0
    stop keymaster-4-0

# fastboot mode services
on property:recovery.fastboot_mode=1
    start vendor.boot-hal-1-0
    start health-hal-2-0

# Touchscreen firmware update trigger
on property:vts_app_recovery.status=run
    start touchupdate
    setprop vts_app_recovery.status running

# --- Crypto services ---

service qseecomd /vendor/bin/qseecomd
    disabled
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib
    oneshot
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/android.hardware.keymaster@4.0-service-qti
    disabled
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib
    oneshot
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/android.hardware.gatekeeper@1.0-service-qti
    disabled
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib
    oneshot
    seclabel u:r:recovery:s0

# --- vivo services ---

service guardianangle /system/bin/guardianangle
    disabled
    user root
    seclabel u:r:recovery:s0

service keystore_auth /system/bin/keystore_auth
    disabled
    user system
    group root system
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    disabled
    user root
    group root drmrpc readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0

# --- HAL services for fastboot mode ---

service vendor.boot-hal-1-0 /vendor/bin/hw/android.hardware.boot@1.0-service
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service health-hal-2-0 /vendor/bin/hw/android.hardware.health@2.0-service
    disabled
    user root
    group root
    seclabel u:r:recovery:s0
