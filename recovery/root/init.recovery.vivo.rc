# vivo PD1936 recovery initialization
# USB/ADB configuration for recovery
# Touchscreen properties are set in init.recovery.touch.rc on early-init

on init
    # Ensure USB controller is set for ADB functionality
    setprop sys.usb.controller "a600000.dwc3"
    setprop sys.usb.configfs 1
    # Ensure ADB is enabled in recovery (MTP is disabled via TW_EXCLUDE_MTP)
    setprop persist.sys.usb.config "adb"
    setprop ro.adb.secure 0
