# vivo PD1936 recovery initialization
# USB/ADB config + touchscreen firmware update trigger
# on init is confirmed working (ADB properties are set correctly)

on init
    # Ensure USB controller is set for ADB functionality
    setprop sys.usb.controller "a600000.dwc3"
    setprop sys.usb.configfs 1
    # Ensure ADB is enabled in recovery (MTP is disabled via TW_EXCLUDE_MTP)
    setprop persist.sys.usb.config "adb"
    setprop ro.adb.secure 0
    # Run touchscreen firmware update directly via exec
    # ro.build.oem.projects is set via PRODUCT_DEFAULT_PROPERTY_OVERRIDES in device.mk
    # and also in init.recovery.touch.rc on early-init
    exec u:r:recovery:s0 root root -- /system/bin/vts_app_recovery --update
