# vivo PD1936 recovery initialization
# USB/ADB config + touchscreen firmware update trigger
# This file is confirmed to be loaded by TWRP init (ADB properties work)

on init
    # Ensure USB controller is set for ADB functionality
    setprop sys.usb.controller "a600000.dwc3"
    setprop sys.usb.configfs 1
    # Ensure ADB is enabled in recovery (MTP is disabled via TW_EXCLUDE_MTP)
    setprop persist.sys.usb.config "adb"
    setprop ro.adb.secure 0

on boot
    # Start touchscreen firmware update service
    # vts_app_recovery needs ro.build.oem.projects (set in init.recovery.touch.rc on early-init)
    # and vendor/firmware/*.bin files to match the product name
    start touchupdate
    # Backup: also run directly via exec in case service start fails
    exec u:r:recovery:s0 root root -- /system/bin/vts_app_recovery --update
